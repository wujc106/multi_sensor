  COMMAND = cmd.exe /C "cd /D E:\GD32\user_code\multi_sensor\simulator\build\simulator && E:\GD32\GD32EmbeddedUI-0.3.0-beta-win\resources\external\mingw64\bin\cmake.exe --regenerate-during-build -SE:\GD32\user_code\multi_sensor -BE:\GD32\user_code\multi_sensor\simulator\build"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build simulator/rebuild_cache: phony simulator/CMakeFiles/rebuild_cache.util

